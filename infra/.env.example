# Copy to infra/.env and adjust. NEVER commit the real .env.
# These defaults are for local development only — use strong secrets elsewhere.
OCSRC_DB_NAME=site_risk_checker
OCSRC_DB_USER=app
OCSRC_DB_PASSWORD=dev_only_password

# Server-side AI memo broker (Anthropic). The key stays on the server;
# the browser never receives or stores it (external evaluation Phase 0).
OCSRC_ANTHROPIC_API_KEY=
OCSRC_ANTHROPIC_MODEL=claude-sonnet-5
